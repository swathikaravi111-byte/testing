{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=TimeXDB;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-that-is-very-long-and-secure-minimum-256-bits-required",
    "Issuer": "TimeX.API",
    "Audience": "TimeX.Web",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://timex.example.com"
  ],
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4-turbo-preview"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
